{
  "name": "ghost-vanguard",
  "version": "3.2.1",
  "private": true,
  "description": "Security, moderation and support tickets for the Midtown Discord network: anti-nuke, moderation, audit logging, server recovery and a full ticket desk",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build/clean.mjs && tsc",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "doctor": "node --import tsx src/doctor.ts",
    "database:restore": "node scripts/ops/restore-database.mjs",
    "database:drop-csb": "node scripts/ops/drop-csb-tables.mjs",
    "scam:setup": "node scripts/ops/scam-setup.mjs",
    "docs": "node --import tsx scripts/docs/generate.ts",
    "dashboard": "node dist/dashboard/server.js",
    "dashboard:demo": "node --import tsx scripts/ops/dashboard-demo.mjs"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "17.2.3",
    "openai": "7.32.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
