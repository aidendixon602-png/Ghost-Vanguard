# Copy to .env and fill in. Never upload your real .env.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Exact approved Discord user IDs with Developer access to protected application commands.
# Administrator or server ownership does not grant Developer access.
DEVELOPER_IDS=

# Local Windows: keep ./data when upgrading.
# Hosting: MUST point to a mounted persistent disk, e.g. /var/data/vanguard/vanguard.db.
DATABASE_PATH=./data/vanguard.db
HEALTH_HOST=127.0.0.1
HEALTH_PORT=7475

# Optional providers; unavailable providers preserve existing verification roles.
ROVER_API_KEY=
BLOXLINK_API_KEY=

AI_ENABLED=false
OPENAI_API_KEY=
# The exact model name your OpenAI project can access. Required when AI_ENABLED=true.
OPENAI_MODEL=

# Optional gap between restore actions, in milliseconds (0-60000). 0 = none.
# Try 1000 for very large restores; Discord's own rate limits are always respected.
SNAPSHOT_ACTION_DELAY_MS=0

# Verified, rotating SQLite backups. Use a persistent directory on hosting.
DATABASE_BACKUP_DIRECTORY=./data/database-backups
DATABASE_BACKUP_INTERVAL_MINUTES=60
DATABASE_BACKUP_KEEP_RECENT=24
DATABASE_BACKUP_KEEP_DAILY=14
DATABASE_BACKUP_KEEP_WEEKLY=8
GUILD_RETENTION_DAYS=90

# Readable PowerShell logs by default; use json for machine ingestion.
LOG_FORMAT=pretty
LOG_LEVEL=info
# The bot owner has the Developer rank for ordinary permission checks. /restart additionally requires
# an exact DEVELOPER_IDS entry, preserving its existing restricted access.
BOT_OWNER_ID=
# Supreme Leaders (comma-separated user IDs): bot-wide rank below Developer.
# They cannot issue/lift network bans or use Developer-only commands. Nobody is built in.
# Every start prints who has bot-wide access; check it lists only people you trust.
SUPREME_LEADER_IDS=
BOT_OWNER_USERNAME=


# Uptime alert (optional): make a free check at https://healthchecks.io, paste its ping URL here,
# and connect Discord/email alerts there. If the bot stops pinging, you get alerted.
HEARTBEAT_URL=
# Who the bot DMs about itself: the daily database backup file, back-online and backup-failure alerts,
# empty-database warnings and genreban exceptions. Comma-separated user IDs. Default: BOT_OWNER_ID only.
# Ranks never add anyone here: Supreme Leaders and developers get nothing unless listed.
TRUSTED_DM_IDS=
# DM the daily database backup to TRUSTED_DM_IDS (true/false). Default: true
DAILY_BACKUP_DM=true

# Automatic updates from GitHub (optional). When both are set, launch.js checks the repo every
# few minutes and installs a new commit only after GitHub's tests passed for it.
# UPDATE_TOKEN: a fine-grained token with read-only "Contents" and "Actions" on this repo only.
# For public repos, if GitHub rejects the token the launcher retries read-only checks without it.
# UPDATE_REPO: owner/repo, e.g. aidendixon602-png/Ghost-Vanguard (the full GitHub link also works).
UPDATE_REPO=
UPDATE_TOKEN=
UPDATE_BRANCH=main
UPDATE_INTERVAL_MINUTES=5

# Command blacklist: who may not use which commands, in every server. Changes need a restart.
# Format: <user ID>:<command>|<command>;<user ID>:<command>   (commands as typed, without the slash)
#   "mod ban" blocks one subcommand, "mod" blocks everything under /mod, "*" blocks every command and button.
# The bot owner (BOT_OWNER_ID) can never be blocked.
COMMAND_BLACKLIST=

# Protected roles: role IDs that only PROTECTED_ROLE_ASSIGNERS (and Developers) may give, however it is done
# (/role, the control panel, or by hand in Discord). Anyone else who gives one has it taken back, and you are alerted.
PROTECTED_ROLES=
PROTECTED_ROLE_ASSIGNERS=

# Lock anti-nuke: only Developers can turn it off or change its layers; servers switched off come back on at start.
ANTINUKE_LOCK=true
# People staff can never ban, kick, time out or take roles from (by hand or through the bot). Only Developers can.
PROTECTED_USERS=
# Global anti-nuke feed: every trigger from every server is also posted here (overrides /dev alerts).
GLOBAL_ALERT_CHANNEL_ID=
# Also post first-time warnings to the global feed (true/false). Default: false
GLOBAL_ALERT_WARNINGS=false

# Also alert (log card, global feed, DM) when the owner, Developers or whitelisted people hit a limit.
# Default false: they are only recorded in /antinuke incidents.
ALERT_EXEMPT=false
