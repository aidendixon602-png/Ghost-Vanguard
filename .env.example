TypeScript: Restart TS Serverly. Never upload your real .env.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Exact approved Discord user IDs for all comma-prefix commands; include the bot owner's ID too if needed.
# Administrator, server ownership or another bot-wide rank does not grant comma-command access.
DEVELOPER_IDS=

# Local Windows: keep ./data when upgrading.
# Hosting: MUST point to a mounted persistent disk, e.g. /var/data/vanguard/vanguard.db.
DATABASE_PATH=./data/vanguard.db
HEALTH_HOST=127.0.0.1
HEALTH_PORT=7475

# Optional providers; unavailable providers preserve existing verification roles.
ROVER_API_KEY=
BLOXLINK_API_KEY=

AI_ENABLED=false
OPENAI_API_KEY=
# Choose an API model your project can access when enabling /ask.
OPENAI_MODEL=gpt-6-luna

# Optional gap between restore actions, in milliseconds (0-60000). 0 = none.
# Try 1000 for very large restores; Discord's own rate limits are always respected.
SNAPSHOT_ACTION_DELAY_MS=0

# Verified, rotating SQLite backups. Use a persistent directory on hosting.
DATABASE_BACKUP_DIRECTORY=./data/database-backups
DATABASE_BACKUP_INTERVAL_MINUTES=60
DATABASE_BACKUP_KEEP_RECENT=24
DATABASE_BACKUP_KEEP_DAILY=14
DATABASE_BACKUP_KEEP_WEEKLY=8
GUILD_RETENTION_DAYS=90

# Readable PowerShell logs by default; use json for machine ingestion.
LOG_FORMAT=pretty
LOG_LEVEL=info
# The bot owner has the Developer rank. Comma-prefix commands still require an exact DEVELOPER_IDS entry,
# so add the owner's ID there too if they should use ,help, ,restart and other Developer commands.
BOT_OWNER_ID=
# Supreme Leaders (comma-separated user IDs): bot-wide rank below Developer; may lift genrebans from ban-log controls.
# Developer comma commands still require exact membership in DEVELOPER_IDS. Nobody is built in.
# Every start prints who has bot-wide access; check it lists only people you trust.
SUPREME_LEADER_IDS=
BOT_OWNER_USERNAME=


# Uptime alert (optional): make a free check at https://healthchecks.io, paste its ping URL here,
# and connect Discord/email alerts there. If the bot stops pinging, you get alerted.
HEARTBEAT_URL=
# Who the bot DMs about itself: the daily database backup file, back-online and backup-failure alerts,
# empty-database warnings and genreban exceptions. Comma-separated user IDs. Default: BOT_OWNER_ID only.
# Ranks never add anyone here: Supreme Leaders and developers get nothing unless listed.
TRUSTED_DM_IDS=
# DM the daily database backup to TRUSTED_DM_IDS (true/false). Default: true
DAILY_BACKUP_DM=true

# The bot dashboard is enabled by default. Set this to false to serve only /healthz.
DASHBOARD_ENABLED=true
# When the dashboard is enabled, this token protects its page and API. Keep it private.
DASHBOARD_TOKEN=

# Automatic updates from GitHub (optional). When both are set, launch.js checks the repo every
# few minutes and installs a new commit only after GitHub's tests passed for it.
# UPDATE_TOKEN: a fine-grained token with read-only "Contents" and "Actions" on this repo only.
# UPDATE_REPO: owner/repo, e.g. aidendixon602-png/Ghost-Vanguard (the full GitHub link also works).
UPDATE_REPO=
UPDATE_TOKEN=
UPDATE_BRANCH=main
UPDATE_INTERVAL_MINUTES=5
